{
  "name": "pika-ranked-bedwars-tickets",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0",
    "npm": ">=11"
  },
  "scripts": {
    "build": "npm run prisma:generate && tsc",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run prisma:validate",
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps ./dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
